# En local, laissez ces deux lignes vides ou absentes : le projet utilisera
# automatiquement un fichier SQLite local (local.db) via libSQL.
#
# En production (Vercel), créez une base gratuite sur https://turso.tech,
# puis renseignez ici l'URL et le token qu'ils vous donnent :
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Clé secrète utilisée pour signer les sessions de l'espace professionnel.
# Générez-en une nouvelle en production, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changez-moi-en-une-longue-chaine-aleatoire

# Mot de passe de l'espace admin (accessible sur /admin/login), réservé au
# propriétaire de la plateforme pour consulter les commissions dues par
# l'ensemble des centres. Choisissez un mot de passe fort et gardez-le secret.
ADMIN_PASSWORD=changez-moi

# Adresse publique du site (utilisée dans les liens des emails automatiques).
SITE_URL=https://ct-rdv.onrender.com

# Envoi d'emails automatiques via Resend (https://resend.com, gratuit pour
# démarrer). Sans ces variables, les emails ne sont simplement pas envoyés
# (aucune erreur, juste un message dans les logs).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Créneau CT <onboarding@resend.dev>

# Notifications Telegram à l'admin (nouveau compte pro, nouvelle réservation).
# Créez un bot via @BotFather sur Telegram pour obtenir ces deux valeurs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clé secrète pour protéger la route de rappel automatique
# (/api/cron/rappels?cle=...), à appeler une fois par jour par un service
# de tâche planifiée externe et gratuit (ex: cron-job.org).
CRON_SECRET=changez-moi-aussi
